# Copy to `.env` (gitignored) and fill in the blanks.
#
# Spring Boot reads this file at startup through `spring.config.import` in
# application.properties, so nothing needs exporting in the shell. Real
# environment variables still win over it — which is how a host will supply
# these values once the app is deployed.

DB_URL=jdbc:postgresql://localhost:5432/caltracker
DB_USERNAME=caltracker_app
DB_PASSWORD=

FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# Print Hibernate's generated SQL to the console.
SHOW_SQL=true

# Only needed when the frontend is served from somewhere other than localhost.
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
